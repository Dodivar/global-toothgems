# Edge Function secrets — names only, never values in Git.
# Remote project: supabase secrets set --env-file supabase/functions/.env
# Local:          supabase functions serve --env-file supabase/functions/.env
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided by Supabase to every
# deployed function (and by `supabase functions serve` locally): do not set them.

# Stripe secret key — TEST mode (sk_test_…) until launch.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint (whsec_…): from the Stripe dashboard
# endpoint, or printed by `stripe listen` locally.
STRIPE_WEBHOOK_SECRET=
# Production site origin: Stripe return addresses and the team invitation
# link (<SITE_URL>/auth/confirm?next=/reinitialiser-mot-de-passe) are built on it.
SITE_URL=https://globaltoothgems.com
# Other origins allowed to start a checkout or invite a team member and get
# their own return / invitation addresses (comma-separated, exact origins),
# e.g. local dev and previews.
ALLOWED_RETURN_ORIGINS=http://localhost:5173

# --- E-mail (Resend, decision 79) --------------------------------------------
# API key with "Sending access" only (re_…), from the Resend dashboard once the
# sending domain is verified. Used by _shared/email and nothing else.
RESEND_API_KEY=
# Sender and reply-to. The domain of EMAIL_FROM must be verified in Resend.
EMAIL_FROM=Global Tooth Gems <no-reply@globaltoothgems.com>
EMAIL_REPLY_TO=contact@globaltoothgems.com
# Signing secret of the Resend webhook endpoint (whsec_…), for `resend-webhook`.
RESEND_WEBHOOK_SECRET=
# Shared secret the Next.js server routes send to `send-email` (long random
# string). The same value goes in the webapp's server-side environment.
EMAIL_INTERNAL_SECRET=
