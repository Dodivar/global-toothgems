# Edge Function secrets — names only, never values in Git.
# Remote project: supabase secrets set --env-file supabase/functions/.env
# Local:          supabase functions serve --env-file supabase/functions/.env
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided by Supabase to every
# deployed function (and by `supabase functions serve` locally): do not set them.

# Stripe secret key — TEST mode (sk_test_…) until launch.
STRIPE_SECRET_KEY=
# Publishable key of the SAME account and mode (pk_test_… with sk_test_…): sent to
# the browser to mount the payment form on our checkout page (decision 80).
STRIPE_PUBLISHABLE_KEY=
# Signing secret of the webhook endpoint (whsec_…): from the Stripe dashboard
# endpoint, or printed by `stripe listen` locally.
STRIPE_WEBHOOK_SECRET=
# Production site origin: Stripe return addresses and the team invitation
# link (<SITE_URL>/auth/confirm?next=/reinitialiser-mot-de-passe) are built on it.
SITE_URL=https://globaltoothgems.com
# Other origins allowed to start a checkout or invite a team member and get
# their own return / invitation addresses (comma-separated, exact origins),
# e.g. local dev and previews.
ALLOWED_RETURN_ORIGINS=http://localhost:5173

# --- E-mail (Resend, decision 79) --------------------------------------------
# API key with "Sending access" only (re_…), from the Resend dashboard once the
# sending domain is verified. Used by _shared/email and nothing else.
RESEND_API_KEY=
# Sender and reply-to. The domain of EMAIL_FROM must be verified in Resend.
EMAIL_FROM=Global Tooth Gems <no-reply@globaltoothgems.com>
EMAIL_REPLY_TO=contact@globaltoothgems.com
# Signing secret of the Resend webhook endpoint (whsec_…), for `resend-webhook`.
RESEND_WEBHOOK_SECRET=
# Shared secret the Next.js server routes send to `send-email` (long random
# string). The same value goes in the webapp's server-side environment.
EMAIL_INTERNAL_SECRET=

# --- 3D Studio smile try-on (decision 111) ------------------------------------
# The image model id ("Nano Banana", as Google's documentation names it), and
# ONE way in. Until both are set, `studio-try-on` answers not_available and
# the Studio says the AI try-on is coming.
GEMINI_IMAGE_MODEL=
# (a) Vertex AI with a Google credentials file (no API key): the whole content
# of a service account key (type "service_account", the dedicated account; its
# role: Vertex AI User) or, for a person, of the file written by
# `gcloud auth application-default login` (type "authorized_user"). Set it from
# the file, never paste it in a chat; the secrets file route avoids shell
# quoting problems with the JSON's double quotes:
#   printf 'GOOGLE_ADC_JSON=%s\n' "$(jq -c . key.json)" > /tmp/adc.env
#   npx supabase secrets set --env-file /tmp/adc.env   (then delete both files)
GOOGLE_ADC_JSON=
# Optional: the Google Cloud project (default: the file's project_id / quota_project_id)
# and the Vertex AI location (default: global).
# GOOGLE_CLOUD_PROJECT=global-toothgems
# GOOGLE_CLOUD_LOCATION=global
# (b) or the Gemini API with a key (+ optional base, default public v1beta).
# GEMINI_API_KEY=
# GEMINI_API_BASE=
# Optional: AI renders per account per 24 hours (default 10).
# TRY_ON_DAILY_LIMIT=10
# TRY_ON_DAILY_CHECKS=30
# TRY_ON_CHECK_MODEL=gemini-3.1-flash-lite
# Optional: system instructions, v2 (default: revised + design data) or v1
# (the owner's original, images only). See studio-try-on/systemPrompt.ts.
# TRY_ON_PROMPT_VERSION=v3
