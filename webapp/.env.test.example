# Live E2E suite (npm run test:e2e:live, playwright.live.config.ts).
#
# Values of a LOCAL Supabase stack only: from the repository root run
#   supabase start
#   supabase status -o env
# and copy API_URL, PUBLISHABLE_KEY (or ANON_KEY) and SERVICE_ROLE_KEY below,
# then export them in your shell (the suite reads the environment, not this file).
# e2e-live/env.ts refuses any address other than localhost / 127.0.0.1, so a
# real project's URL or key can never be used here by mistake.
#
# The other suites need nothing: unit tests and the smoke tests run in mock
# mode, the auth-server tests against e2e/support/fake-supabase.mjs.

E2E_SUPABASE_URL=http://127.0.0.1:54321
E2E_SUPABASE_PUBLISHABLE_KEY=
E2E_SUPABASE_SERVICE_KEY=

# Optional
# E2E_LIVE_SERVER=start        # build and serve the production bundle instead of `next dev`
# E2E_LIVE_BASE_URL=           # an already running server
# E2E_LIVE_PORT=5197
